{
  "name": "ecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:hono": "pnpm --filter @ecommerce/hono dev",
    "dev:frontend": "pnpm --filter @ecommerce/frontend dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @ecommerce/hono db:generate",
    "db:push": "pnpm --filter @ecommerce/hono db:push",
    "db:migrate": "pnpm --filter @ecommerce/hono db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.7.3"
  }
}
