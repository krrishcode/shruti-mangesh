---
import Layout from '../../layouts/Layout.astro';
import { HeaderInteractive } from '../../components/HeaderInteractive';
import Footer from '../../components/Footer.astro';
import { UserPortalLayout } from '../../react/user/components/UserPortalLayout';
import { WishlistView } from '../../react/user/components/views/WishlistView';
---

<Layout title="Wishlist | Mangesh Mahadev">
  <HeaderInteractive client:load />
  <main class="bg-[#FAF8F5] min-h-screen pt-8 pb-20">
    <UserPortalLayout activeTab="wishlist" client:load>
      <WishlistView client:load />
    </UserPortalLayout>
  </main>
  <Footer />
</Layout>
