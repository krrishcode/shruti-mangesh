---
import Layout from '../../layouts/Layout.astro';
import { HeaderInteractive } from '../../components/HeaderInteractive';
import Footer from '../../components/Footer.astro';
import { UserPortalLayout } from '../../react/user/components/UserPortalLayout';
import { OverviewView } from '../../react/user/components/views/OverviewView';
---

<Layout title="My Account | Mangesh Mahadev">
  <HeaderInteractive client:load />
  <main class="bg-[#FAF8F5] min-h-screen pt-8 pb-20">
    <UserPortalLayout activeTab="overview" client:load>
      <OverviewView client:load />
    </UserPortalLayout>
  </main>
  <Footer />
</Layout>
