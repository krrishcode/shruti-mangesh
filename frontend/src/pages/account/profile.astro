---
import Layout from '../../layouts/Layout.astro';
import { HeaderInteractive } from '../../components/HeaderInteractive';
import Footer from '../../components/Footer.astro';
import { UserPortalLayout } from '../../react/user/components/UserPortalLayout';
import { ProfileView } from '../../react/user/components/views/ProfileView';
---

<Layout title="Profile & Measurements | Mangesh Mahadev">
  <HeaderInteractive client:load />
  <main class="bg-[#FAF8F5] min-h-screen pt-8 pb-20">
    <UserPortalLayout activeTab="profile" client:load>
      <ProfileView client:load />
    </UserPortalLayout>
  </main>
  <Footer />
</Layout>
