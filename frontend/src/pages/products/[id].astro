---
import Layout from '../../layouts/Layout.astro';
import { HeaderInteractive } from '../../components/HeaderInteractive';
import { ProductDetailView } from '../../components/ProductDetailView';
import Footer from '../../components/Footer.astro';
import { MENS_PRODUCTS } from '../../data/mensCollection';

export async function getStaticPaths() {
  const map = new Map<string, any>();
  MENS_PRODUCTS.forEach((p) => map.set(String(p.id), p));

  try {
    const res = await fetch('http://localhost:4000/api/products');
    if (res.ok) {
      const json = await res.json();
      if (Array.isArray(json.data)) {
        json.data.forEach((p: any) => {
          let parsedSizes = ['38', '40', '42', '44', '46', '48'];
          let parsedInStock = ['38', '40', '42', '44', '46'];
          try {
            if (typeof p.sizes === 'string') parsedSizes = JSON.parse(p.sizes);
            else if (Array.isArray(p.sizes)) parsedSizes = p.sizes;
          } catch {}
          try {
            if (typeof p.inStockSizes === 'string') parsedInStock = JSON.parse(p.inStockSizes);
            else if (Array.isArray(p.inStockSizes)) parsedInStock = p.inStockSizes;
          } catch {}

          map.set(String(p.id), {
            id: String(p.id),
            title: p.title,
            category: p.categoryName || 'Sherwanis',
            price: Number(p.price),
            salePrice: p.salePrice ? Number(p.salePrice) : null,
            sku: p.sku,
            imageFront: p.imageFront || 'https://www.anitadongre.com/dw/image/v2/BGCX_PRD/on/demandware.static/-/Sites-masterCatalog_AD_India/default/dwf27d8283/images/hires/FW26/F26MP8SR_BEIGE_1.jpg?sw=850&sh=1275&sm=fit&strip=false',
            imageDetail: p.imageDetail || 'https://www.anitadongre.com/dw/image/v2/BGCX_PRD/on/demandware.static/-/Sites-masterCatalog_AD_India/default/dw6c58fa09/images/hires/FW26/F26MP8SR_BEIGE_3.jpg?sw=850&sh=1275&sm=fit&strip=false',
            color: p.color || 'Beige',
            colorHex: p.colorHex || '#D6C7B2',
            craft: p.craft || 'Imperial Metallic Zardozi & Resham',
            description: p.description || '',
            badge: p.badge || 'EXCLUSIVE',
            sizes: parsedSizes,
            inStockSizes: parsedInStock,
            readyToShip: Boolean(p.readyToShip),
            styleNumber: p.styleNumber,
            measurements: p.measurements,
            fabricContent: p.fabricContent,
            componentsCount: p.componentsCount,
            setIncludes: p.setIncludes,
            washCare: p.washCare,
            countryOfOrigin: p.countryOfOrigin,
            manufacturerAddress: p.manufacturerAddress,
            returnsPolicy: p.returnsPolicy,
            disclaimer: p.disclaimer,
            editorialStory: p.editorialStory,
            deliveryMethod: p.deliveryMethod || 'both',
            colorVariants: typeof p.colorVariants === 'string' ? JSON.parse(p.colorVariants) : p.colorVariants,
            gallery: typeof p.gallery === 'string' ? JSON.parse(p.gallery) : (Array.isArray(p.gallery) ? p.gallery : []),
          });
        });
      }
    }
  } catch (e) {
    // Backend offline fallback to local static data
  }

  return Array.from(map.values()).map((prod) => ({
    params: { id: String(prod.id) },
    props: { product: prod },
  }));
}

const { product } = Astro.props;
---

<Layout
  title={`${product.title} | Mangesh Mahadev Haute Couture`}
  description={product.description}
>
  {/* Luxury Navigation Header */}
  <HeaderInteractive client:load />

  <main id="main">
    {/* Interactive Product Detail Page Island */}
    <ProductDetailView client:load product={product} />
  </main>

  {/* House of Mangesh Mahadev Footer */}
  <Footer />
</Layout>
